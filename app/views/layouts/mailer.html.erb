<%# Shared layout for every email Flextensions sends. Styles are inline because
    most mail clients ignore <style> blocks. Mailers may set:
      @course              - its course code is shown in the header
      @cta_label/@cta_url  - a button rendered under the message body %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= message.subject %></title>
  </head>

  <body style="margin:0; padding:0; background-color:#f4f5f7; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color:#212529;">
    <div style="max-width:600px; margin:0 auto; padding:24px 12px;">
      <div style="background-color:#003262; color:#ffffff; padding:16px 24px; border-bottom:4px solid #fdb515; font-size:18px; font-weight:bold; line-height:1.3;">
        <%= [ @course&.course_code, 'Flextensions' ].compact_blank.join(' | ') %>
      </div>
      <div style="background-color:#ffffff; padding:24px; font-size:16px; line-height:1.5;">
        <%= yield %>
        <% if @cta_url.present? %>
          <p style="margin:24px 0 0;">
            <a href="<%= @cta_url %>" style="display:inline-block; background-color:#003262; color:#ffffff; padding:12px 20px; border-radius:4px; font-size:15px; font-weight:bold; text-decoration:none;">
              <%= @cta_label.presence || 'Open Flextensions' %>
            </a>
          </p>
        <% end %>
      </div>
      <div style="padding:16px 24px; font-size:13px; line-height:28px; color:#6c757d;">
        <%= image_tag 'uc-berkeley-logo.png', alt: 'UC Berkeley', height: 28, style: 'height:28px; vertical-align:middle; margin-right:8px;' %>
        Sent by <a href="<%= root_url %>" style="color:#6c757d;"><%= root_url.chomp('/') %></a>
        | <a href="https://docs.flextensions.berkeley.edu" style="color:#6c757d;">Get Help</a>
      </div>
    </div>
  </body>
</html>
