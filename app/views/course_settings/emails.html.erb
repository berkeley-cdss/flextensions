<%# All copy on this page comes from config/locales/en.yml under
    course_settings.emails; `t('.key')` is scoped to that path automatically.
    Each template card carries its own email-template Stimulus controller so
    "Reset to Default" only touches the subject and body inside that card. %>
<div class="container-fluid mb-5">
    <div class="row">
        <div class="col-12">
            <%= render "courses/course_title" %>
            <h1 class="sr-only"><%= t('.title') %></h1>
            <%= form_with url: course_settings_path(@course), method: :patch,
                          data: {
                            controller: 'course-settings unsaved-changes',
                            action: 'input->unsaved-changes#markDirty change->unsaved-changes#markDirty submit->unsaved-changes#save'
                          } do |form| %>
                <%= render 'shared/unsaved_changes_toast' %>

                <div class="card rounded-0 mb-4">
                    <div class="card-header bg-light">
                        <h2 class="card-title mb-0 h5"><%= t('.notifications.title') %></h2>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info" role="note"><%= t('.notifications.note_html') %></div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <%= hidden_field_tag 'course_settings[enable_emails]', false %>
                                <%= check_box_tag 'course_settings[enable_emails]',
                                                 true,
                                                 @course_settings.enable_emails,
                                                 class: 'form-check-input',
                                                 id: 'enable-email' %>
                                <label class="form-check-label" for="enable-email"><%= t('.notifications.enable_label') %></label>
                            </div>
                        </div>

                        <div class="mb-0 row">
                            <label for="reply-email" class="col-sm-4 col-form-label"><%= t('.notifications.reply_email_label') %></label>
                            <div class="col-sm-8">
                                <%= email_field_tag 'course_settings[reply_email]',
                                                  @course_settings.reply_email,
                                                  class: 'form-control',
                                                  id: 'reply-email',
                                                  placeholder: t('.notifications.reply_email_placeholder'),
                                                  data: { course_settings_target: "emailField" },
                                                  disabled: !@course_settings.enable_emails %>
                                <small class="text-muted"><%= t('.notifications.reply_email_hint') %></small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card rounded-0 mb-4">
                    <div class="card-header bg-light">
                        <h2 class="card-title mb-0 h5"><%= t('.staff_copies.title') %></h2>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <div class="form-check form-switch">
                                <%= hidden_field_tag 'course_settings[cc_course_staff]', false %>
                                <%= check_box_tag 'course_settings[cc_course_staff]',
                                                 true,
                                                 @course_settings.cc_course_staff,
                                                 class: 'form-check-input',
                                                 id: 'cc-course-staff' %>
                                <label class="form-check-label" for="cc-course-staff"><%= t('.staff_copies.toggle_label') %></label>
                            </div>
                        </div>
                        <p class="text-muted mb-0"><%= t('.staff_copies.description') %></p>
                    </div>
                </div>

                <% [
                     { key: 'approval', subject_field: 'email_subject', body_field: 'email_template',
                       default_subject: CourseSettings::DEFAULT_APPROVAL_EMAIL_SUBJECT, default_body: CourseSettings::DEFAULT_APPROVAL_EMAIL_TEMPLATE },
                     { key: 'denial', subject_field: 'denial_email_subject', body_field: 'denial_email_template',
                       default_subject: CourseSettings::DEFAULT_DENIAL_EMAIL_SUBJECT, default_body: CourseSettings::DEFAULT_DENIAL_EMAIL_TEMPLATE }
                   ].each do |template| %>
                    <% title = t(".templates.#{template[:key]}.title") %>
                    <div class="card rounded-0 mb-4"
                         data-controller="email-template"
                         data-email-template-default-subject-value="<%= template[:default_subject] %>"
                         data-email-template-default-body-value="<%= template[:default_body] %>">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h2 class="card-title mb-0 h5"><%= title %></h2>
                            <%= button_tag t('.templates.reset'),
                                          type: "button",
                                          class: "btn btn-secondary btn-sm",
                                          aria: { label: t('.templates.reset_aria', template: title.downcase) },
                                          data: { action: 'email-template#reset unsaved-changes#markDirty' } %>
                        </div>
                        <div class="card-body">
                            <p class="text-muted"><%= t(".templates.#{template[:key]}.description") %></p>

                            <div class="mb-3">
                                <label for="<%= template[:key] %>-email-subject" class="form-label"><%= t('.templates.subject_label') %></label>
                                <%= text_field_tag "course_settings[#{template[:subject_field]}]",
                                                 @course_settings.public_send(template[:subject_field]).presence || template[:default_subject],
                                                 class: 'form-control',
                                                 id: "#{template[:key]}-email-subject",
                                                 data: { 'email-template-target': 'subject' } %>
                            </div>

                            <div class="mb-0">
                                <label for="<%= template[:key] %>-email-template" class="form-label"><%= t('.templates.body_label') %></label>
                                <%= text_area_tag "course_settings[#{template[:body_field]}]",
                                                @course_settings.public_send(template[:body_field]).presence || template[:default_body],
                                                class: 'form-control',
                                                id: "#{template[:key]}-email-template",
                                                rows: 10,
                                                data: { 'email-template-target': 'body' } %>
                                <small class="text-muted"><%= t('.templates.body_hint') %></small>
                            </div>
                        </div>
                    </div>
                <% end %>

                <div class="card bg-light rounded-0 mb-4">
                    <div class="card-body">
                        <h2 class="card-title h5"><%= t('.variables.title') %></h2>
                        <p class="text-muted mb-2"><%= t('.variables.description') %></p>
                        <% {
                             student: %w[student_name student_email student_id],
                                 course: %w[course_name course_code assignment_name request_url],
                                 request: %w[request_details_table original_due_date new_due_date requested_due_date extension_days status]
                           }.each do |group, variables| %>
                            <p class="mb-1 fw-bold" id="email-variables-<%= group %>"><%= t(".variables.groups.#{group}") %></p>
                            <table class="table table-sm table-borderless w-auto mb-3 email-variables-table" style="--bs-table-bg: transparent;"
                                   aria-labelledby="email-variables-<%= group %>">
                                <thead class="visually-hidden">
                                    <tr>
                                        <th scope="col"><%= t('.variables.columns.variable') %></th>
                                        <th scope="col"><%= t('.variables.columns.description') %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% variables.each do |variable| %>
                                        <% placeholder = "{{#{variable}}}" %>
                                        <tr>
                                            <td class="text-nowrap ps-0 pe-4">
                                                <code><%= placeholder %></code><%= copy_to_clipboard_button(placeholder, label: t('.variables.copy', variable: placeholder)) %>
                                            </td>
                                            <td><%= t(".variables.#{variable}") %></td>
                                        </tr>
                                    <% end %>
                                </tbody>
                            </table>
                        <% end %>
                    </div>
                </div>

                <div class="text-start mb-4">
                    <%= form.submit t('.save'), class: 'btn btn-success px-4' %>
                </div>
            <% end %>
        </div>
    </div>
</div>
