# Load balancer health check path, declared in the repo so it can be changed
# through a normal deploy rather than in the environment's console settings.
#
# Before this file existed the path was not configured anywhere in the repo, so
# the environment used its default and the load balancer polled `/`. That page
# is the marketing landing page: it runs the full session/authentication stack,
# and a bug there (see the session_user comment in application_controller.rb)
# turned every health check into a 302 to /courses and failed every deploy.
#
# /status/health_check (StatusController#health_check, config/routes.rb) is
# unauthenticated, returns JSON, and runs a `SELECT 1` against the database.
# Note that it currently returns HTTP 200 even when the database check fails
# (the failure is reported in the JSON body), so the load balancer only takes
# an instance out of service when Rails itself cannot answer.
#
# Two options are set because Elastic Beanstalk uses different namespaces
# depending on the load balancer type:
#   - `Application Healthcheck URL` is the classic option and is what the
#     console's "Health check path" field maps to for Classic Load Balancers.
#   - `aws:elasticbeanstalk:environment:process` / `default` / HealthCheckPath
#     is what an Application Load Balancer target group actually uses.
# Setting both keeps this correct whichever load balancer the environment has.
#
# NOTE ON PRECEDENCE: option settings applied directly to an environment (via
# the console or the API) override values from .ebextensions. If the health
# check path was ever set explicitly on this environment, that value wins and
# this file is ignored. Verify after deploying with:
#
#   aws elasticbeanstalk describe-configuration-settings \
#     --application-name <app> --environment-name <env> \
#     --query "ConfigurationSettings[0].OptionSettings[?OptionName=='Application Healthcheck URL' || OptionName=='HealthCheckPath']"
#
# If an environment-level value is present, remove it so the repo controls it:
#
#   aws elasticbeanstalk update-environment --environment-name <env> \
#     --options-to-remove Namespace=aws:elasticbeanstalk:application,OptionName="Application Healthcheck URL" \
#                         Namespace=aws:elasticbeanstalk:environment:process,ResourceName=default,OptionName=HealthCheckPath
option_settings:
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /status/health_check
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /status/health_check
    MatcherHTTPCode: '200'
