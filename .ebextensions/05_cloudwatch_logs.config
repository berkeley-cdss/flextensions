# Elastic Beanstalk instance log streaming, declared in the repo rather than
# set on the environment, so it can be changed through a normal deploy without
# console permissions on the environment itself.
#
# DeleteOnTerminate is the setting that matters here. Deployments use the
# Immutable policy, so a failed deploy launches an instance, fails its health
# check, and terminates it. If EB deletes that instance's log streams on
# termination, the only copy of eb-engine.log and web.stdout.log for the failed
# instance goes with it -- which is exactly the position we have been in for
# the last several attempts.
#
# NOTE ON PRECEDENCE: option settings applied directly to an environment (via
# the console or the API) override values from .ebextensions. If any of these
# were ever set explicitly on this environment, that value wins and the line
# below is ignored. Verify after deploying with:
#
#   aws elasticbeanstalk describe-configuration-settings \
#     --application-name <app> --environment-name <env> \
#     --query "ConfigurationSettings[0].OptionSettings[?Namespace=='aws:elasticbeanstalk:cloudwatch:logs']"
#
# This is separate from 04_cloudwatch_agent.config, which configures the
# CloudWatch *agent* for custom metrics. Both are required for logs to arrive:
# this enables streaming, and 04 must use `append-config` so it does not delete
# the agent configuration EB installs to do the streaming.
option_settings:
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 7
